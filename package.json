{
  "name": "profils-actifs",
  "version": "1.0.0",
  "private": true,
  "description": "ProfilsActifs - Plateforme JEB de valorisation des compétences",
  "packageManager": "npm@12.0.2",
  "scripts": {
    "postinstall": "npm run generate -w @profils-actifs/db",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "turbo": "^2.10.12",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-native": "npm:typescript@^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
