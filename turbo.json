{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    },
    "build": {
      "outputs": ["dist/**", ".next/**"],
      "cache": true,
      "dependsOn": ["^build"]
    },
    "test": {
      "outputs": ["coverage/**"],
      "cache": true,
      "inputs": ["src/**", "test/**", "package.json", "jest.config.js", "tsconfig.json"],
      "dependsOn": ["^build"]
    },
    "lint": {
      "outputs": [],
      "cache": true,
      "inputs": ["src/**", "package.json", "eslint.config.js", "tsconfig.json"]
    },
    "db:migrate": {
      "cache": false,
      "inputs": ["prisma/**"],
      "dependsOn": []
    },
    "db:seed": {
      "cache": false,
      "dependsOn": ["db:migrate"]
    }
  },
  "globalDependencies": [
    ".env.local",
    ".env",
    "jest.preset.mjs",
    "eslint.base.mjs",
    "tsconfig.json"
  ]
}
