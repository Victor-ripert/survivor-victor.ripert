# Database
DATABASE_URL="postgresql://profils_user:profils_password@localhost:5432/profils_actifs_dev"

# Optional. Only `prisma migrate diff --from-migrations` reads it, to replay the
# migrations directory into a throwaway database and check it rebuilds exactly
# the schema (scripts/preuves/schema-conforme.sh creates and drops it). Leave it
# unset for everyday work: `prisma migrate dev` then manages its own temporary
# shadow database, as it does today.
# SHADOW_DATABASE_URL="postgresql://profils_user:profils_password@localhost:5432/profils_actifs_shadow"

# API Server
API_PORT=3000
API_HOST=localhost
NODE_ENV=development

# Frontend
VITE_API_URL=http://localhost:3000/api

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d

# CORS — comma-separated origins allowed to call the API from a browser
CORS_ORIGIN=http://localhost:5173

# Security — 100 requests per 15 minutes per IP (brief). Raise
# RATE_LIMIT_MAX_REQUESTS for a live demonstration from a single machine.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Direct video upload (brief §8.5). The size cap and the content-type check
# are enforced in services/video-providers/local.ts; the HTTP route still
# answers 501 because the demonstrator ships iframe embedding only (YouTube/Vimeo).
MAX_VIDEO_SIZE=104857600
# Must resolve outside this repository — services/video-providers/local.ts
# refuses to write there otherwise. "./uploads" would land inside
# packages/api/, which is git-tracked application code. A sibling directory
# (as below) or an absolute path (e.g. /var/lib/profils-actifs/uploads in
# production) both work.
UPLOAD_DIR=../profils-actifs-uploads
# Which VideoProvider backs `type: UPLOAD` video storage (see
# services/video-provider.ts). 'local' writes to UPLOAD_DIR above and is the
# only functional option today; 'ministry-placeholder' stands in for the
# ministry's own PeerTube instance (not yet available — always reports
# 'unavailable', for exercising degraded-mode handling); 'external-link'
# forces the YouTube/Vimeo provider even for an upload request, mainly
# useful for testing the interface itself. EXTERNAL_LINK videos
# (YouTube/Vimeo links a candidate pastes) are unaffected by this — they
# always go through the external-link provider regardless.
VIDEO_PROVIDER=local
