# Database
DATABASE_URL="postgresql://profils_user:profils_password@localhost:5432/profils_actifs_dev"

# Optional. Only `prisma migrate diff --from-migrations` reads it, to replay the
# migrations directory into a throwaway database and check it rebuilds exactly
# the schema (scripts/preuves/schema-conforme.sh creates and drops it). Leave it
# unset for everyday work: `prisma migrate dev` then manages its own temporary
# shadow database, as it does today.
# SHADOW_DATABASE_URL="postgresql://profils_user:profils_password@localhost:5432/profils_actifs_shadow"

# API Server
API_PORT=3000
API_HOST=localhost
NODE_ENV=development

# Frontend
VITE_API_URL=http://localhost:3000/api

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# --- Not read by the application today ---------------------------------------
# config/env.ts parses the whole environment with Zod and rejects it at boot if
# a required key is missing; none of the keys below appear in that schema, so
# setting them changes nothing. They are kept as placeholders for two features
# that are specified but not built: e-mail notifications are delivered in-app
# only (services/notifications.ts writes rows, it sends nothing), and video is
# iframe embedding, with no direct upload. Whoever implements either one adds
# the key to config/env.ts in the same change — otherwise this file promises
# configuration that does not exist.

# Email (not implemented — notifications are in-app)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# File upload (not implemented — videos are iframe embeds, see §8.5)
MAX_VIDEO_SIZE=104857600
# Must resolve outside this repository — video.service.ts refuses to write
# there otherwise. "./uploads" would land inside packages/api/, which is
# git-tracked application code. A sibling directory (as below) or an
# absolute path (e.g. /var/lib/profils-actifs/uploads in production) both work.
UPLOAD_DIR=../profils-actifs-uploads

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
