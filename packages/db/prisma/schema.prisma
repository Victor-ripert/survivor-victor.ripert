generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  APPLICANT
  RECRUITER
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole
  isActive     Boolean   @default(true)
  birthDate    DateTime?

  profile              Profile?
  attempts             CertificationAttempt[]
  notifications        Notification[]
  moderationLogs       ModerationLog[]
  interactionsCreated  Interaction[]          @relation("InteractionCreatedBy")
  interactionsReceived Interaction[]          @relation("InteractionRecipient")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

enum NotificationType {
  NEW_INTERACTION_RECEIVED
  CERTIFICATION_BADGE_EARNED
  // Sent when an admin edits an active question while the candidate has an
  // IN_PROGRESS attempt — see services/certification/invalidation.ts.
  CERTIFICATION_ATTEMPT_INVALIDATED
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String

  // Optional deep link to the interaction that triggered this notification.
  interactionId String?
  interaction   Interaction? @relation(fields: [interactionId], references: [id], onDelete: SetNull)

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model Skill {
  id   String @id @default(cuid())
  name String @unique

  profiles ProfileSkill[]

  // The unique btree above serves exact lookups; the catalogue matches skill
  // names case-insensitively, which is an ILIKE the btree cannot answer.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model ProfileSkill {
  id String @id @default(cuid())

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  level SkillLevel @default(INTERMEDIATE)

  @@unique([profileId, skillId])
  // Reverse direction of the unique index above: the catalogue's skill facet
  // starts from a skill and asks which profiles carry it. Both columns are in
  // the index, so that lookup never touches the heap. Supersedes a standalone
  // index on skillId, which was only its prefix.
  @@index([skillId, profileId])
}

enum CertificationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  headline String?
  bio      String?
  location String
  sector   String

  skills ProfileSkill[]
  videos Video[]

  certificationStatus CertificationStatus @default(PENDING)
  certificationScore  Int? // 0-100, set when an attempt completes
  certificationBadge  String? // resolved from CertificationLevel at scoring time

  moderationStatus ModerationStatus @default(PENDING)
  moderationLogs   ModerationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // `sector` and `location` are filtered case-insensitively, which Prisma
  // emits as ILIKE — a plain btree cannot answer that, so these two are
  // trigram indexes. See docs/decisions/02-index-du-catalogue.md for the
  // measurements and for why write-time normalisation was not chosen instead.
  @@index([sector(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([location(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([certificationStatus])
  @@index([moderationStatus])
  // `sort=score`, the catalogue's certification ordering.
  @@index([certificationScore])
  // The default catalogue ordering, column for column: `ORDER BY "updatedAt"
  // DESC, id ASC`. Both columns are in the index and in the right direction,
  // so Postgres walks it in order and the paging query needs no sort step.
  // Supersedes a standalone index on `updatedAt`, which was only its prefix.
  // The pair is also unique, which is what makes the ordering total — and what
  // a later move to keyset pagination would seek on. See
  // docs/livrables/note-algorithme-de-classement.md.
  @@index([updatedAt(sort: Desc), id])
}

enum VideoType {
  EXTERNAL_LINK
  UPLOAD
}

model Video {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  title       String
  description String?
  type        VideoType
  url         String // external link (YouTube/Vimeo) or storage path, depending on type
  duration    Int? // seconds

  // Which VideoProvider produced this video, and the opaque ref its store()
  // returned (packages/api/src/services/video-provider.ts). `providerName`
  // is a plain string, not a Prisma enum: it's written straight from
  // VideoProviderName ('local' | 'ministry-placeholder' | 'external-link'),
  // and a second, hand-kept enum here would only give the two a way to drift
  // apart. Both nullable — rows written before this migration don't have
  // them yet; `packages/db/src/migrate-video-providers.ts` (`npm run
  // db:migrate-video-providers`) is the replayable script that derives them
  // from `url` + `type` for rows still missing one. `url` remains what every
  // reader, including the API's Video DTO, actually serves from; these two
  // exist so `deleteVideo` can call the provider that really stored the
  // bytes, rather than whichever provider VIDEO_PROVIDER currently names.
  // Not in openapi.yaml's Video schema — internal storage bookkeeping, not
  // something an API consumer needs.
  providerRef  String?
  providerName String?

  fileSizeBytes Int? // set for UPLOAD only; app layer enforces the 100MB cap (brief §3.2)

  // Storage path of the WebVTT caption track, for UPLOAD only — subtitles are
  // an accessibility obligation, not a comfort option (courriel du 7 septembre).
  // An embedded video cannot carry one: the track would have to live inside the
  // third party's player, which is why only our own <video> element can honour
  // it. Deleted with the video file when consent is revoked.
  captionsUrl String?

  moderationStatus ModerationStatus @default(PENDING)
  moderationLogs   ModerationLog[]

  // Consent to publication is logged, not merely ticked: the moment it was
  // given and the version of the text that was accepted (brief §7.1).
  // Revocation deletes the row and the file rather than flagging them, so
  // there is deliberately no `revokedAt` here: a column that can only ever be
  // written on a row being removed is a column that stays empty.
  acceptedAt         DateTime
  consentTextVersion String

  // Restored after 20260902133533_add_video_consent dropped it. That migration
  // announces the drop in its own header ("All the data in the column will be
  // lost"), which reads as collateral rather than intent: every other table
  // carries createdAt, the catalogue orders a profile's preview video by it,
  // and a consent record without a deposit date is a poor audit trail.
  createdAt DateTime @default(now())

  @@index([profileId])
}

// Mirrors the POST /admin/profiles/{id}/moderate payload (action/reason/notes)
// from openapi.yaml — one row per moderation decision, so status changes stay
// auditable instead of just overwriting Profile.moderationStatus in place.
enum ModerationAction {
  APPROVE
  REJECT
  FLAG
  REQUIRE_CHANGES
}

// Covers both Profile and Video moderation, which is why exactly one of
// profileId/videoId is set per row, never both, never neither — Prisma has
// no declarative "exactly one of these columns" constraint, so this
// invariant is enforced in the app layer (moderation.service.ts), the same
// way CLAUDE.md documents other rules the schema itself can't express
// (e.g. at most one IN_PROGRESS CertificationAttempt per user). Real
// foreign keys on both columns (rather than a generic entityType +
// string entityId pair) keep referential integrity and cascading deletes
// working normally for whichever one is actually set.
model ModerationLog {
  id String @id @default(cuid())

  adminId String
  admin   User   @relation(fields: [adminId], references: [id])

  profileId String?
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  videoId String?
  video   Video?  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  action ModerationAction
  reason String?
  notes  String?

  createdAt DateTime @default(now())

  @@index([profileId])
  @@index([videoId])
  @@index([adminId])
}

// Score-range lookup for badge tiers — see design-rules note at top of file.
model CertificationLevel {
  id           String  @id @default(cuid())
  name         String  @unique // e.g. "Certifié JEB"
  minScore     Int // inclusive lower bound, 0-100 scale
  maxScore     Int // inclusive upper bound, 0-100 scale
  badgeIconUrl String?
  order        Int     @default(0)
  isActive     Boolean @default(true)

  @@index([minScore, maxScore])
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_TEXT
  CHECKBOX
  LIKERT_SCALE
}

model CertificationQuestion {
  id          String       @id @default(cuid())
  order       Int
  type        QuestionType
  text        String
  description String?
  weight      Int          @default(1) // multiplier applied to earned points
  maxPoints   Int          @default(10)
  isActive    Boolean      @default(true)

  options CertificationOption[]
  answers Answer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

// Used for MULTIPLE_CHOICE/CHECKBOX questions; each option's `points` is the
// admin-editable "pondération" the brief asks for.
model CertificationOption {
  id         String                @id @default(cuid())
  questionId String
  question   CertificationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  text   String
  points Int    @default(0)
  order  Int    @default(0)

  answers Answer[]

  @@index([questionId])
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  EXPIRED
}

// Single row (id "current"), refreshed every `npm run db:seed`, recording
// which version of certification/questions.v1.json is currently loaded.
// CertificationAttempt.questionnaireVersion is stamped from this at creation
// time — see Thomas Vignal's brief (2026-09-07) on tracking the version a
// candidate was actually scored against.
model QuestionnaireVersion {
  id       String   @id @default("current")
  version  String
  loadedAt DateTime @updatedAt
}

model CertificationAttempt {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status AttemptStatus @default(IN_PROGRESS)
  score  Int? // computed on completion, 0-100 scale

  // Which certification/questions.v*.json version this attempt was created
  // against — set once, at creation, from QuestionnaireVersion. The default
  // exists only so the migration doesn't fail on rows that predate this
  // column; new rows always get an explicit value.
  questionnaireVersion String @default("v1")

  answers Answer[]

  startedAt      DateTime  @default(now())
  lastActivityAt DateTime  @updatedAt // drives save/resume and EXPIRED transitions
  expiresAt      DateTime?
  completedAt    DateTime?

  // App layer enforces at most one IN_PROGRESS attempt per user, so a
  // candidate always resumes the same attempt rather than starting a new one.
  @@index([userId, status])
}

// One row per submitted answer. CHECKBOX questions produce multiple rows
// (one per selected option) sharing the same attemptId/questionId, which is
// why this isn't uniquely keyed on that pair.
model Answer {
  id        String               @id @default(cuid())
  attemptId String
  attempt   CertificationAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId String
  question   CertificationQuestion @relation(fields: [questionId], references: [id])

  optionId String? // MULTIPLE_CHOICE / CHECKBOX
  option   CertificationOption? @relation(fields: [optionId], references: [id])

  textAnswer    String? // SHORT_TEXT
  numericAnswer Int? // LIKERT_SCALE

  pointsEarned Int @default(0)

  createdAt DateTime @default(now())

  @@index([attemptId, questionId])
}

enum InteractionType {
  VIEW
  CONTACT
  FAVORITE
  MESSAGE
}

model Interaction {
  id String @id @default(cuid())

  recipientId String // applicant being contacted
  recipient   User   @relation("InteractionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  createdById String // recruiter / admin acting
  createdBy   User   @relation("InteractionCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  type       InteractionType
  message    String? // set for CONTACT/MESSAGE
  isViewed   Boolean         @default(false)
  isFavorite Boolean         @default(false)

  notifications Notification[]

  createdAt DateTime @default(now())

  @@index([recipientId, type])
  @@index([createdById, type, createdAt])
}
