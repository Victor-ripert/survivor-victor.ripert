{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "dependsOn": [
        "^build"
      ],
      "persistent": true
    },
    "build": {
      "outputs": [
        "dist/**",
        ".next/**"
      ],
      "cache": true,
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "outputs": [
        "coverage/**"
      ],
      "cache": true,
      "inputs": [
        "src/**",
        "test/**",
        "package.json"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "outputs": [],
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "inputs": [
        "prisma/**"
      ],
      "dependsOn": []
    },
    "db:seed": {
      "cache": false,
      "dependsOn": [
        "db:migrate"
      ]
    }
  },
  "globalDependencies": [
    ".env.local",
    ".env"
  ]
}
